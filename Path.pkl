/// A filesystem path name.
module pklpath.Path

/// A component of a path: an anchor, a regular segment, `..`, or the
/// current-directory marker `.`.
typealias Component = Anchor | Normal | ParentDir | CurrentDir

/// The anchor of an absolute path. For Unix this is `"/"`. The anchor is always
/// the first element of `parts` when the path is absolute.
class Anchor {
  value: String(!isEmpty)
  function toString(): String = value
}

/// A regular path segment.
class Normal {
  value: String(!isEmpty)
  function toString(): String = value
}

/// A `..` segment, preserved lexically rather than resolved against a preceding
/// component.
class ParentDir {
  function toString(): String = ".."
}

/// The current-directory marker `.`. Only appears as the sole component of the
/// current-directory path itself; intermediate `.` segments are stripped during
/// normalization.
class CurrentDir {
  function toString(): String = "."
}

/// Creates a path from a string.
///
/// Separator runs are collapsed, extraneous `.` parts and trailing slashes are
/// dropped and an empty path is represented as `.`.
function unix(value: String): module =
  let (collapseSeparators = (v) -> v.replaceAll(Regex("/+"), "/"))
  let (dropTrailingSlash = (v) -> if (v != root && v.endsWith("/")) v.dropLast(1) else v)
  let (
    dropDots = (v) ->
      v
        .replaceFirst(Regex(#"^(\./(?!$))+"#), "")
        .replaceAll(Regex(#"/(\./)+"#), "/")
        .replaceFirst(Regex(#"(((?<!^)/|(?<=^/))\.)+$"#), "")
  )
    if (value.isEmpty)
      ofNormalized(".")
    else
      ofNormalized(value |> collapseSeparators |> dropTrailingSlash |> dropDots)

local function ofNormalized(value: String): module = (module) { path = value }

/// The path after Unix separator normalization.
path: String(!isEmpty)

/// The path separator for Unix paths.
fixed separator: "/" = "/"

/// The root path.
fixed root: "/" = "/"

/// Tells whether this path starts at the filesystem root.
fixed isAbsolute: Boolean = path.startsWith(separator)

/// Tells whether this path does not start at the filesystem root.
fixed isRelative: Boolean = !isAbsolute

/// Tells whether this path is the root of the filesystem.
fixed isRoot: Boolean = path == root

/// The components of the path. Always non-empty.
///
/// The first element is the [Anchor] when the path is absolute, or [CurrentDir]
/// for the current-directory path. A `..` segment is exposed as [ParentDir];
/// other segments are [Normal].
fixed parts: List<Component>(!isEmpty) =
  if (path == ".")
    List(new CurrentDir {})
  else if (isRoot)
    List(new Anchor { value = root })
  else
    let (rawSegments = path.split(separator))
    let (segments = if (isAbsolute) rawSegments.drop(1) else rawSegments)
    let (head: List<Component> = if (isAbsolute) List(new Anchor { value = separator }) else List())
      head + segments.map((s) -> componentOf(s))

/// The final segment of the path, or empty when the path has no segment.
///
/// Root and the current-directory path have no name. `..` is treated as a
/// regular segment and so has the name `..`.
fixed name: String =
  if (isRoot || path == ".")
    ""
  else
    let (i = path.lastIndexOfOrNull(separator))
      if (i == null) path else path.drop(i + 1)

/// The final extension of `name`, including its leading dot, or empty when
/// `name` has none. A leading or trailing dot in `name` is not treated as an
/// extension boundary, so `.bashrc` and `foo.` have no suffix.
fixed suffix: String =
  if (!name.contains("."))
    ""
  else
    let (i = name.lastIndexOf("."))
      if (i > 0 && i < name.length - 1) name.drop(i) else ""

/// `name` with its final `suffix` removed.
fixed stem: String = if (suffix.isEmpty) name else name.dropLast(suffix.length)

/// The extensions on `name`, ordered from outermost to innermost. Hidden
/// files like `.bashrc` and names ending in `.` have no suffixes.
fixed suffixes: List<String> =
  if (name.isEmpty || name.endsWith("."))
    List()
  else
    name.replaceFirst(Regex(#"^\.+"#), "").split(".").drop(1).map((s) -> ".\(s)")

/// The path with its final segment removed.
///
/// Root and the current-directory path are their own parent. Other
/// single-segment paths have `.` as their parent.
///
/// The result is purely lexical: the rightmost segment is stripped whatever it
/// is, including `..`. So `foo/..` has `foo` as its parent (not `..`), `..` has
/// `.` as its parent (not `../..`), and `a/b/..` has `a/b` as its parent (not
/// `.`). If it seems wrong, it is simply because it is, but less so than the
/// alternative, which will yield different normalized paths in the presence of
/// symlinks. This creates bugs that are hard to discover and have security
/// implications.
function parent(): module =
  if (isRoot || path == ".")
    ofNormalized(path)
  else
    let (i = path.lastIndexOfOrNull(separator))
      if (i == null)
        ofNormalized(".")
      else if (i == 0)
        ofNormalized(separator)
      else
        ofNormalized(path.take(i))

/// The chain of ancestors, ordered from immediate parent outward.
function parents(): List<module> =
  if (isRoot || path == ".")
    List()
  else
    let (p = parent()) List(p) + p.parents()

function toString(): String = path

function withTrailingSlash(): String = if (isRoot) path else "\(path)\(separator)"

/// Joins this path with `other`.
///
/// A relative `other` is appended to this path. An absolute `other` replaces
/// this path entirely. The result is purely lexical: `..` segments are
/// preserved rather than resolved against the preceding component.
function join(other: module): module =
  if (other.isAbsolute)
    other
  else
    unix("\(path)\(separator)\(other.path)")

local function componentOf(segment: String): Component =
  if (segment == "..") new ParentDir {} else new Normal { value = segment }
