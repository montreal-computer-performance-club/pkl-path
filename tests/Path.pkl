amends "pkl:test"

import "../Path.pkl"

facts {
  ["stores canonical unix path strings"] {
    Path.unix("foo").path == "foo"
    Path.unix("foo/").path == "foo"
    Path.unix("/").path == "/"
    Path.unix("///").path == "/"
    Path.unix("/srv//app///lib/").path == "/srv/app/lib"
    Path.unix("").path == "."
  }

  ["tracks absolute and relative paths"] {
    Path.unix("/srv/app").isAbsolute
    !Path.unix("/srv/app").isRelative
    Path.unix("srv/app").isRelative
    !Path.unix("srv/app").isAbsolute
    Path.unix("/").isAbsolute
    !Path.unix("/").isRelative
    Path.unix("").isRelative
    !Path.unix("").isAbsolute
  }

  ["exposes parts including unix root"] {
    Path.unix("/srv/app/./config.pkl").parts == List(
      new Path.Anchor { value = "/" },
      new Path.Normal { value = "srv" },
      new Path.Normal { value = "app" },
      new Path.Normal { value = "config.pkl" }
    )
    Path.unix("../state/").parts == List(
      new Path.ParentDir {},
      new Path.Normal { value = "state" }
    )
    Path.unix(".config").parts == List(new Path.Normal { value = ".config" })
    Path.unix("/").parts == List(new Path.Anchor { value = "/" })
    Path.unix("").parts == List(new Path.CurrentDir {})
  }

  ["removes extraneous dots"] {
    Path.unix(".").path == "."
    Path.unix("/.").path == "/"
    Path.unix("/./.").path == "/"
    Path.unix("./").path == "."
    Path.unix("././").path == "."
    Path.unix("/./").path == "/"
    Path.unix("/././").path == "/"
    Path.unix("././foo").path == "foo"
    Path.unix("foo/./.").path == "foo"
    Path.unix("foo/././foo").path == "foo/foo"
    Path.unix("././.config").path == ".config"
    Path.unix(".config/./.").path == ".config"
    Path.unix(".config/././.config").path == ".config/.config"
    Path.unix("./../.config").path == "../.config"
  }

  ["preserves dot-dot parts"] {
    Path.unix("/srv/app/../config.pkl").path == "/srv/app/../config.pkl"
    Path.unix("../srv").parts == List(
      new Path.ParentDir {},
      new Path.Normal { value = "srv" }
    )
    Path.unix("srv/..").parts == List(
      new Path.Normal { value = "srv" },
      new Path.ParentDir {}
    )
  }

  ["renders path strings"] {
    Path.unix("/srv/app").toString() == "/srv/app"
    Path.unix("/srv/app").withTrailingSlash() == "/srv/app/"
    Path.unix("foo").withTrailingSlash() == "foo/"
    Path.unix("/").withTrailingSlash() == "/"
    Path.unix("").withTrailingSlash() == "./"
  }

  ["appends segments when joining a relative path"] {
    Path.unix("foo").join(Path.unix("bar")) == Path.unix("foo/bar")
    Path.unix("foo/bar").join(Path.unix("baz/qux")) == Path.unix("foo/bar/baz/qux")
    Path.unix("/srv").join(Path.unix("app/config.pkl")) == Path.unix("/srv/app/config.pkl")
    Path.unix("foo/").join(Path.unix("bar")) == Path.unix("foo/bar")
    Path.unix("foo").join(Path.unix("bar/")) == Path.unix("foo/bar")
  }

  ["replaces the base when joining an absolute path"] {
    Path.unix("foo").join(Path.unix("/bar")) == Path.unix("/bar")
    Path.unix("/srv/app").join(Path.unix("/etc")) == Path.unix("/etc")
    Path.unix(".").join(Path.unix("/")) == Path.unix("/")
    Path.unix("/").join(Path.unix("/etc")) == Path.unix("/etc")
  }

  ["joins from and onto the root path"] {
    Path.unix("/").join(Path.unix("etc")) == Path.unix("/etc")
    Path.unix("/").join(Path.unix("etc/passwd")) == Path.unix("/etc/passwd")
    Path.unix("/").join(Path.unix(".")) == Path.unix("/")
    Path.unix("/").join(Path.unix("")) == Path.unix("/")
  }

  ["treats the current-directory path as an identity when joining"] {
    Path.unix("foo").join(Path.unix(".")) == Path.unix("foo")
    Path.unix(".").join(Path.unix("foo")) == Path.unix("foo")
    Path.unix("foo").join(Path.unix("")) == Path.unix("foo")
    Path.unix("").join(Path.unix("foo")) == Path.unix("foo")
    Path.unix(".").join(Path.unix(".")) == Path.unix(".")
    Path.unix("").join(Path.unix("")) == Path.unix(".")
  }

  ["preserves dot-dot segments when joining"] {
    Path.unix("foo").join(Path.unix("..")) == Path.unix("foo/..")
    Path.unix("foo").join(Path.unix("../bar")) == Path.unix("foo/../bar")
    Path.unix("foo/bar").join(Path.unix("../..")) == Path.unix("foo/bar/../..")
    Path.unix("/").join(Path.unix("..")) == Path.unix("/..")
    Path.unix("..").join(Path.unix("..")) == Path.unix("../..")
  }

  ["exposes the name of the final segment"] {
    Path.unix("/srv/app/config.pkl").name == "config.pkl"
    Path.unix("foo/bar").name == "bar"
    Path.unix("foo").name == "foo"
    Path.unix("foo/").name == "foo"
    Path.unix(".bashrc").name == ".bashrc"
    Path.unix("..").name == ".."
    Path.unix("foo/..").name == ".."
    Path.unix("/").name == ""
    Path.unix(".").name == ""
    Path.unix("").name == ""
  }

  ["exposes the suffix and stem of the name"] {
    Path.unix("config.pkl").suffix == ".pkl"
    Path.unix("config.pkl").stem == "config"
    Path.unix("/srv/app/config.pkl").suffix == ".pkl"
    Path.unix("/srv/app/config.pkl").stem == "config"
    Path.unix("archive.tar.gz").suffix == ".gz"
    Path.unix("archive.tar.gz").stem == "archive.tar"
    Path.unix(".bashrc").suffix == ""
    Path.unix(".bashrc").stem == ".bashrc"
    Path.unix(".tar.gz").suffix == ".gz"
    Path.unix(".tar.gz").stem == ".tar"
    Path.unix("README").suffix == ""
    Path.unix("README").stem == "README"
    Path.unix("foo.").suffix == ""
    Path.unix("foo.").stem == "foo."
    Path.unix("..").suffix == ""
    Path.unix("..").stem == ".."
    Path.unix("/").suffix == ""
    Path.unix("/").stem == ""
    Path.unix(".").suffix == ""
    Path.unix(".").stem == ""
  }

  ["lists every suffix from outermost to innermost"] {
    Path.unix("archive.tar.gz").suffixes == List(".tar", ".gz")
    Path.unix("config.pkl").suffixes == List(".pkl")
    Path.unix(".tar.gz").suffixes == List(".gz")
    Path.unix(".bashrc").suffixes == List()
    Path.unix("README").suffixes == List()
    Path.unix("foo.").suffixes == List()
    Path.unix("..").suffixes == List()
    Path.unix("/").suffixes == List()
    Path.unix(".").suffixes == List()
  }

  ["exposes the parent path"] {
    Path.unix("/srv/app/config.pkl").parent() == Path.unix("/srv/app")
    Path.unix("/foo").parent() == Path.unix("/")
    Path.unix("foo/bar/baz").parent() == Path.unix("foo/bar")
    Path.unix("foo/bar").parent() == Path.unix("foo")
    Path.unix("foo").parent() == Path.unix(".")
    Path.unix("..").parent() == Path.unix(".")
    Path.unix("foo/..").parent() == Path.unix("foo")
    Path.unix("../bar").parent() == Path.unix("..")
    Path.unix("/").parent() == Path.unix("/")
    Path.unix(".").parent() == Path.unix(".")
    Path.unix("").parent() == Path.unix(".")
    Path.unix("foo/").parent() == Path.unix(".")
  }

  ["strips dot-dot segments lexically rather than resolving them"] {
    Path.unix("../..").parent() == Path.unix("..")
    Path.unix("a/b/..").parent() == Path.unix("a/b")
    Path.unix("foo/../bar").parent() == Path.unix("foo/..")
    Path.unix("../../..").parent() == Path.unix("../..")
  }

  ["lists ancestors from immediate parent outward"] {
    Path.unix("/srv/app/config.pkl").parents()
      == List(Path.unix("/srv/app"), Path.unix("/srv"), Path.unix("/"))
    Path.unix("foo/bar/baz").parents()
      == List(Path.unix("foo/bar"), Path.unix("foo"), Path.unix("."))
    Path.unix("/foo").parents() == List(Path.unix("/"))
    Path.unix("foo").parents() == List(Path.unix("."))
    Path.unix("..").parents() == List(Path.unix("."))
    Path.unix("/").parents() == List()
    Path.unix(".").parents() == List()
  }
}
